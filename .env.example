# Copy this file to .env and fill in your real DashScope key.
# Get one at https://modelstudio.console.alibabacloud.com/ (international/Singapore region
# for the free trial quota. The endpoint below must match that region).
DASHSCOPE_API_KEY=

# Optional settings. The defaults are shown below.
# QWEN_MODEL=qwen3.8-max
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_TIMEOUT_SECONDS=240
# QWEN_MAX_RETRIES=1

# If requests keep timing out at ~480s (240s x 2 attempts), the intl endpoint
# may be stalling on the response leg -- see Troubleshooting in README.md.
# The mainland endpoint has been reliable as a fallback with the same key:
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
